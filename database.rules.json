{
  "rules": {
    "lenme": {
      "queue": {
        ".read": true,
        ".write": true
      },
      "online": {
  ".read": "auth != null",
  "$uid": {
    ".write": "auth != null && auth.uid === $uid"
  }
      
      },
      "rooms": {
        "$roomId": {
          ".read": true,
          ".write": true
        }
      }
    }
  }
}
